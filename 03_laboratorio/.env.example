# Copiar a .env en la raíz de 03_laboratorio. Nunca agregar claves a este ejemplo.
# Las variables de la terminal tienen prioridad sobre este archivo.
LLM_BACKEND=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Tu propia clave de Groq (https://console.groq.com/keys). Empieza por gsk y no se comparte.
GROQ_API_KEY=

# OpenAI API (de pago). La clave se crea en https://platform.openai.com/api-keys.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=
OPENAI_API_KEY=

# Base del Caso 1: sqlite (predeterminada) o sqlserver.
DATABASE_BACKEND=sqlite
# Cuenta de ejecución: debe pertenecer al rol caso1_reader y tener solo SELECT.
SQLSERVER_CONNECTION_STRING=
SQLSERVER_SCHEMA=dbo
# Cuenta de preparación opcional; solo se usa en copiar_sqlite_a_sqlserver.py.
SQLSERVER_SETUP_CONNECTION_STRING=

# Modelo local opcional (no hace falta en el laboratorio): LM Studio con un modelo cargado como demo-local.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=demo-local
LOCAL_REASONING_EFFORT=none

# MLflow local con autenticación. Usa valores nuevos; no reutilices una API key.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_TRACKING_USERNAME=admin
# Contraseña de 12 caracteres o más para la UI y el cliente del agente.
MLFLOW_TRACKING_PASSWORD=
# Secreto aleatorio de 32 caracteres o más para proteger sesiones y formularios.
MLFLOW_FLASK_SERVER_SECRET_KEY=

# Caso real SQL Server: usa una cuenta dedicada con SELECT y sin escritura.
MILITARY_SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=servidor,puerto;DATABASE=MilitaryResAllocDB;UID=usuario_solo_lectura;PWD=contraseña;Encrypt=yes;TrustServerCertificate=yes;ApplicationIntent=ReadOnly
